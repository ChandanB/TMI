rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getUserRole() {
      return getUserData().role;
    }

    function getUserDistrictId() {
      return getUserData().get('districtId', null);
    }

    function isDistrictAdmin() {
      return getUserRole() in ['superintendent', 'district_admin', 'administrator', 'admin'];
    }

    function isSameDistrict(districtId) {
      return getUserDistrictId() == districtId;
    }

    // User documents
    match /users/{userId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == userId ||
        isDistrictAdmin()
      );
      allow write: if request.auth.uid == userId;

      // MVP Sub-collections: Students and TMI Plans
      match /students/{studentId} {
        allow read, write: if request.auth.uid == userId;
      }

      match /tmiPlans/{planId} {
        allow read: if request.auth.uid == userId || isDistrictAdmin();
        allow write: if request.auth.uid == userId;
      }

      // Form templates
      match /formTemplates/{templateId} {
        allow read: if request.auth.uid == userId ||
                       (resource.data.get('isPublic', false) == true &&
                        isSameDistrict(resource.data.get('districtId', '')));
        allow write: if request.auth.uid == userId;
      }

      // Form assignments
      match /formAssignments/{assignmentId} {
        allow read: if request.auth.uid == userId || isDistrictAdmin();
        allow write: if request.auth.uid == userId;
      }

      // Form submissions
      match /formSubmissions/{submissionId} {
        allow read: if request.auth.uid == userId ||
                       request.auth.uid == resource.data.get('submittedBy', '') ||
                       isDistrictAdmin();
        allow create: if isAuthenticated();
        allow update: if request.auth.uid == userId ||
                         request.auth.uid == resource.data.get('submittedBy', '');
      }

      // Meetings
      match /meetings/{meetingId} {
        allow read: if request.auth.uid == userId;
        allow write: if request.auth.uid == userId;
      }

      // Resources
      match /resources/{resourceId} {
        allow read, write: if request.auth.uid == userId;
      }

      // Resource assignments (user-scoped)
      match /resourceAssignments/{assignmentId} {
        allow read, write: if request.auth.uid == userId;
      }

      // In-app notifications (user-scoped)
      match /notifications/{notificationId} {
        allow read, write: if request.auth.uid == userId;
      }

      // Interests and hobbies
      match /interests/{interestId} {
        allow read, write: if request.auth.uid == userId;
      }

      match /hobbies/{hobbyId} {
        allow read, write: if request.auth.uid == userId;
      }
    }

    // Districts collection
    match /districts/{districtId} {
      allow read: if isAuthenticated() && (
        isSameDistrict(districtId) || isDistrictAdmin()
      );
      allow write: if isDistrictAdmin() && isSameDistrict(districtId);

      // Schools sub-collection
      match /schools/{schoolId} {
        allow read: if isAuthenticated() && (
          isSameDistrict(districtId) || isDistrictAdmin()
        );
        allow write: if isDistrictAdmin() && isSameDistrict(districtId);
      }

      // Audit logs (read-only for most, write via server-side recommended)
      match /auditLogs/{logId} {
        allow read: if isDistrictAdmin() && isSameDistrict(districtId);
        allow write: if isAuthenticated();
      }

      // Analytics aggregations (server-side only)
      match /analytics/{date} {
        allow read: if isDistrictAdmin() && isSameDistrict(districtId);
        allow write: if false; // Server-side only (Cloud Functions)
      }
    }

    // Global AI-generated resources (shared across all users)
    match /generatedResources/{interestId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();

      // Resources sub-collection
      match /resources/{resourceId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated();
      }
    }

    // Global form templates collection (Phase 1: District Pilot - PR #3)
    match /formTemplates/{templateId} {
      allow read: if isAuthenticated() && (
        // Public templates in same district
        (resource.data.get('isPublic', false) == true &&
         isSameDistrict(resource.data.get('districtId', ''))) ||
        // Own templates
        resource.data.get('createdBy', '') == request.auth.uid ||
        // District admins can see all in their district
        (isDistrictAdmin() && isSameDistrict(resource.data.get('districtId', '')))
      );
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (
        resource.data.get('createdBy', '') == request.auth.uid ||
        isDistrictAdmin()
      );
    }

    // Global resource assignments collection (Phase 1: District Pilot - PR #5)
    match /resourceAssignments/{assignmentId} {
      allow read: if isAuthenticated() && (
        // Student can read their own assignments
        resource.data.get('studentId', '') == request.auth.uid ||
        // Assigner can read assignments they created
        resource.data.get('assignedBy', '') == request.auth.uid ||
        // District admins can read all
        isDistrictAdmin()
      );
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        // Student can update their own assignments (status, notes)
        resource.data.get('studentId', '') == request.auth.uid ||
        // Assigner can update
        resource.data.get('assignedBy', '') == request.auth.uid ||
        // District admins can update all
        isDistrictAdmin()
      );
      allow delete: if isAuthenticated() && (
        resource.data.get('assignedBy', '') == request.auth.uid ||
        isDistrictAdmin()
      );
    }

    // Global Interest Library (Phase 1: Unified Architecture)
    match /interests/{interestId} {
      // All authenticated users can read global interests
      allow read: if isAuthenticated();
      // District admins can create/update global and district interests
      // Personal interests can be created by anyone
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (
        // Own personal interests
        (request.resource.data.get('scope', 'global') == 'personal' &&
         request.resource.data.get('ownerUid', '') == request.auth.uid) ||
        // District admins can manage district/global interests
        isDistrictAdmin()
      );
    }

    // Global Career Library (Phase 1: Unified Architecture)
    match /careers/{careerId} {
      // All authenticated users can read careers
      allow read: if isAuthenticated();
      // Anyone can cache AI-generated careers
      allow create: if isAuthenticated();
      // District admins can update/delete careers
      allow update, delete: if isAuthenticated() && isDistrictAdmin();
    }

    // Global Resource Library (Phase 1: Unified Architecture)
    match /resources/{resourceId} {
      // All authenticated users can read resources
      allow read: if isAuthenticated();
      // Anyone can create resources
      allow create: if isAuthenticated();
      // Update/delete based on scope
      allow update, delete: if isAuthenticated() && (
        // Own personal resources
        (request.resource.data.get('scope', 'global') == 'personal' &&
         request.resource.data.get('ownerUid', '') == request.auth.uid) ||
        // District admins can manage district/global resources
        isDistrictAdmin()
      );
    }

    // Phase 1: District-Scoped Students Collection
    // This is the canonical location for student data (replacing user-scoped /users/{uid}/students)
    match /students/{studentId} {
      // Helper function: Check if user is assigned to this student
      function isAssignedToStudent() {
        return resource.data.get('assignedCounselorId', '') == request.auth.uid ||
               resource.data.get('primaryTeacherId', '') == request.auth.uid ||
               resource.data.get('createdBy', '') == request.auth.uid;
      }
      
      // Helper function: Check if user is in same district as student
      function isStudentInUserDistrict() {
        return resource.data.get('districtId', '') == getUserDistrictId();
      }
      
      // Read: Staff can read students in their district
      allow read: if isAuthenticated() && (
        isStudentInUserDistrict() ||
        isAssignedToStudent() ||
        isDistrictAdmin()
      );
      
      // Create: Staff can create students in their district
      allow create: if isAuthenticated() && (
        request.resource.data.get('districtId', '') == getUserDistrictId() ||
        isDistrictAdmin()
      );
      
      // Update: Assigned staff or district admins can update
      allow update: if isAuthenticated() && (
        isAssignedToStudent() ||
        (isDistrictAdmin() && isStudentInUserDistrict())
      );
      
      // Delete: Only district admins can delete students
      allow delete: if isAuthenticated() && isDistrictAdmin() && isStudentInUserDistrict();
      
      // Student Interest Edges (sub-collection)
      match /studentInterests/{interestId} {
        // Educators can read their students' interests
        allow read: if isAuthenticated();
        // Only authorized users can write student data
        allow write: if isAuthenticated();
      }
      
      // Student Career State (sub-collection)
      match /careerState/{careerId} {
        // Educators can read their students' career state
        allow read: if isAuthenticated();
        // Only authorized users can write student data
        allow write: if isAuthenticated();
      }
    }

    // TMI Plans Collection (Phase 1: District-Scoped)
    match /plans/{planId} {
      // Helper function: Check if user is assigned to this plan
      function isAssignedToPlan() {
        return resource.data.get('assignedCounselorId', '') == request.auth.uid ||
               resource.data.get('createdBy', '') == request.auth.uid ||
               resource.data.get('approvedBy', '') == request.auth.uid;
      }
      
      // Helper function: Check if plan is in user's district
      function isPlanInUserDistrict() {
        return resource.data.get('districtId', '') == getUserDistrictId();
      }
      
      // Read: Staff can read plans in their district or assigned to them
      allow read: if isAuthenticated() && (
        isPlanInUserDistrict() ||
        isAssignedToPlan() ||
        isDistrictAdmin()
      );
      
      // Create: Staff can create plans in their district
      allow create: if isAuthenticated() && (
        request.resource.data.get('districtId', '') == getUserDistrictId() ||
        isDistrictAdmin()
      );
      
      // Update: Assigned staff or district admins can update
      allow update: if isAuthenticated() && (
        isAssignedToPlan() ||
        (isDistrictAdmin() && isPlanInUserDistrict())
      );
      
      // Delete: Only district admins or plan creator can delete
      allow delete: if isAuthenticated() && (
        resource.data.get('createdBy', '') == request.auth.uid ||
        (isDistrictAdmin() && isPlanInUserDistrict())
      );

      // Plan Resource Links (sub-collection)
      match /planResources/{resourceId} {
        // Educators can manage plan resources
        allow read, write: if isAuthenticated();
      }
    }
  }
}
