rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isRespondent() {
      return isAuthenticated()
        && request.auth.token.get('tmiAccessClass', '') == 'respondent';
    }

    function isAuthenticatedNonRespondent() {
      return isAuthenticated() && !isRespondent();
    }

    function trustedDistrictID() {
      return isAuthenticated()
        ? request.auth.token.get('tmiDistrictID', '')
        : '';
    }

    function trustedMembershipVersion() {
      return isAuthenticated()
        ? request.auth.token.get('tmiMembershipVersion', 0)
        : 0;
    }

    function hasTrustedStaffClaim(districtID) {
      return isAuthenticated()
        && request.auth.token.get('tmiAccessClass', '') == 'staff'
        && trustedDistrictID() == districtID
        && trustedMembershipVersion() > 0;
    }

    function membershipPath(districtID) {
      return /databases/$(database)/documents/districts/$(districtID)/members/$(request.auth.uid);
    }

    function membershipExists(districtID) {
      return hasTrustedStaffClaim(districtID)
        && exists(membershipPath(districtID));
    }

    function membership(districtID) {
      return get(membershipPath(districtID)).data;
    }

    function hasActiveMembership(districtID) {
      return membershipExists(districtID)
        && membership(districtID).get('isActive', false) == true
        && membership(districtID).get('version', 0) == trustedMembershipVersion()
        && membership(districtID).get('role', '') in [
          'teacher',
          'counselor',
          'socialWorker',
          'schoolAdministrator',
          'districtAdministrator'
        ];
    }

    function role(districtID) {
      return membership(districtID).get('role', '');
    }

    function hasCapability(districtID, capability) {
      return hasActiveMembership(districtID)
        && capability in membership(districtID).get('capabilities', []);
    }

    function respondentSessionPath(districtID) {
      return /databases/$(database)/documents/districts/$(districtID)/studentModeSessions/$(request.auth.token.get('tmiSessionID', ''));
    }

    function hasActiveRespondentSession(districtID) {
      let claimAssignments = request.auth.token.get('tmiAssignmentIDs', []);
      let claimOperations = request.auth.token.get('tmiAllowedOperations', []);
      let session = get(respondentSessionPath(districtID)).data;
      return isAuthenticated()
        && request.auth.token.get('tmiAccessClass', '') == 'respondent'
        && trustedDistrictID() == districtID
        && request.auth.token.get('tmiStudentID', '') != ''
        && request.auth.token.get('tmiSessionID', '') != ''
        && claimAssignments.size() == 1
        && exists(respondentSessionPath(districtID))
        && session.get('status', '') == 'active'
        && session.get('expiresAt', request.time) > request.time
        && session.get('districtID', '') == districtID
        && session.get('studentID', '')
          == request.auth.token.get('tmiStudentID', '')
        && session.get('respondentUserID', '')
          == request.auth.uid
        && session.get('assignmentIDs', []).size()
          == claimAssignments.size()
        && session.get('assignmentIDs', []).hasOnly(claimAssignments)
        && session.get('allowedOperations', []).size()
          == claimOperations.size()
        && session.get('allowedOperations', []).hasOnly(claimOperations);
    }

    function respondentMay(districtID, studentID, operation) {
      return hasActiveRespondentSession(districtID)
        && hasActiveRespondentAssignment(districtID)
        && request.auth.token.get('tmiStudentID', '') == studentID
        && operation in request.auth.token.get('tmiAllowedOperations', []);
    }

    function respondentAssignmentID(districtID) {
      return get(
        respondentSessionPath(districtID)
      ).data.get('assignmentIDs', [])[0];
    }

    function respondentAssignment(districtID) {
      return get(
        /databases/$(database)/documents/districts/$(districtID)/formAssignments/$(respondentAssignmentID(districtID))
      ).data;
    }

    function hasActiveRespondentAssignment(districtID) {
      let assignment = respondentAssignment(districtID);
      return assignment.get('districtId', '') == districtID
        && assignment.get('isActive', false) == true
        && request.auth.token.get('tmiStudentID', '')
          in assignment.get('studentIDs', []);
    }

    function isScopedRespondentWrite(districtID, studentID, data) {
      return data.get('districtID', '') == districtID
        && data.get('studentID', '') == studentID
        && data.get('respondentSessionID', '')
          == request.auth.token.get('tmiSessionID', '');
    }

    function respondentMayWriteRecord(districtID, studentID, operation) {
      return respondentMay(districtID, studentID, operation)
        && isScopedRespondentWrite(
          districtID,
          studentID,
          request.resource.data
        );
    }

    function respondentMayUpdateRecord(districtID, studentID, operation) {
      return respondentMayWriteRecord(districtID, studentID, operation)
        && isScopedRespondentWrite(districtID, studentID, resource.data)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'districtID',
            'studentID',
            'respondentSessionID'
          ]);
    }

    function respondentMayReadPlanRecord(
      districtID,
      planID,
      recordData
    ) {
      return respondentMay(
          districtID,
          request.auth.token.get('tmiStudentID', ''),
          'readStudentVisiblePlan'
        )
        && request.auth.token.get('tmiStudentID', '')
          in planData(districtID, planID).get('studentIDs', [])
        && recordData.get('studentVisible', false) == true;
    }

    function belongsToSchool(districtID, schoolID) {
      return hasActiveMembership(districtID)
        && schoolID in membership(districtID).get('schoolIDs', []);
    }

    // Assignment authority lives on the student document, matching
    // canListStudent. Requiring membership.assignedStudentIDs as well would
    // make a student unreadable by the teacher who just created it, because
    // only the Admin SDK can write that field.
    function isAssignedStudent(districtID, studentID, studentData) {
      return request.auth.uid in studentData.get('assignedMemberIDs', [])
        && studentData.get('schoolId', '') in membership(districtID).get('schoolIDs', []);
    }

    function canReadStudent(districtID, studentID, studentData) {
      return hasActiveMembership(districtID)
        && studentData.get('districtId', '') == districtID
        && (
          (
            role(districtID) == 'teacher'
            && belongsToSchool(districtID, studentData.get('schoolId', ''))
          )
          || (
            role(districtID) in ['counselor', 'socialWorker']
            && isAssignedStudent(districtID, studentID, studentData)
          )
          || (
            role(districtID) == 'schoolAdministrator'
            && belongsToSchool(districtID, studentData.get('schoolId', ''))
          )
          || role(districtID) == 'districtAdministrator'
        );
    }

    function canListStudent(districtID, studentData) {
      return hasActiveMembership(districtID)
        && (
          (
            role(districtID) == 'teacher'
            && studentData.get('schoolId', '') in membership(districtID).get('schoolIDs', [])
          )
          || (
            role(districtID) in ['counselor', 'socialWorker']
            && request.auth.uid in studentData.get('assignedMemberIDs', [])
            && studentData.get('schoolId', '') in membership(districtID).get('schoolIDs', [])
          )
          || (
            role(districtID) == 'schoolAdministrator'
            && belongsToSchool(districtID, studentData.get('schoolId', ''))
          )
          || role(districtID) == 'districtAdministrator'
        );
    }

    // Lean predicate for direct client writes. Deliberately cheaper than
    // canWriteStudent so an update can evaluate it on both the old and new
    // document without exhausting the rules expression budget.
    // A survey attempt may be written by a member who can write the student it
    // belongs to. Student Mode runs inside that member's session while the
    // respondent token cannot be minted.
    function canWriteSurveyResponse(districtID, studentID) {
      return canClientWriteStudent(
        districtID,
        studentData(districtID, studentID)
      );
    }

    function canClientWriteStudent(districtID, studentData) {
      return hasActiveMembership(districtID)
        && studentData.get('districtId', '') == districtID
        && request.auth.uid in studentData.get('assignedMemberIDs', [])
        && studentData.get('schoolId', '') in membership(districtID).get('schoolIDs', []);
    }

    function canWriteStudent(districtID, studentID, studentData) {
      return hasActiveMembership(districtID)
        && studentData.get('districtId', '') == districtID
        && (
          (
            role(districtID) in ['teacher', 'counselor']
            && isAssignedStudent(districtID, studentID, studentData)
          )
          || (
            role(districtID) == 'schoolAdministrator'
            && hasCapability(districtID, 'student.write.detail')
            && belongsToSchool(districtID, studentData.get('schoolId', ''))
          )
          || (
            role(districtID) == 'districtAdministrator'
            && hasCapability(districtID, 'student.write.detail')
          )
        );
    }

    function studentData(districtID, studentID) {
      return get(
        /databases/$(database)/documents/districts/$(districtID)/students/$(studentID)
      ).data;
    }

    function canReadRestrictedStudentRecord(districtID, studentID) {
      return canReadStudent(
          districtID,
          studentID,
          studentData(districtID, studentID)
        )
        && hasCapability(districtID, 'student.restricted.read');
    }

    function canWriteRestrictedStudentRecord(districtID, studentID) {
      return canReadStudent(
          districtID,
          studentID,
          studentData(districtID, studentID)
        )
        && hasCapability(districtID, 'student.restricted.write');
    }

    function canCollaborateOnStudent(districtID, studentID) {
      let data = studentData(districtID, studentID);
      return hasActiveMembership(districtID)
        && (
          isAssignedStudent(districtID, studentID, data)
          || canWriteStudent(districtID, studentID, data)
        );
    }

    function isValidCareerRelationship(
      districtID,
      studentID,
      careerID,
      data
    ) {
      return data.keys().hasOnly([
          'districtID',
          'studentID',
          'careerID',
          'isSaved',
          'isDismissed',
          'isCompared',
          'linkedPlanIDs',
          'lastViewedAt',
          'respondentSessionID',
          'schemaVersion',
          'recordVersion',
          'createdAt',
          'createdBy',
          'updatedAt',
          'updatedBy'
        ])
        && data.keys().hasAll([
          'districtID',
          'studentID',
          'careerID',
          'isSaved',
          'isDismissed',
          'isCompared',
          'linkedPlanIDs',
          'schemaVersion',
          'recordVersion',
          'createdAt',
          'createdBy',
          'updatedAt',
          'updatedBy'
        ])
        && data.get('districtID', '') == districtID
        && data.get('studentID', '') == studentID
        && data.get('careerID', '') == careerID
        && data.get('isSaved', false) is bool
        && data.get('isDismissed', false) is bool
        && data.get('isCompared', false) is bool
        && !(data.get('isSaved', false) && data.get('isDismissed', false))
        && data.get('linkedPlanIDs', []) is list
        && data.get('schemaVersion', 0) == 1
        && data.get('recordVersion', 0) is int
        && data.get('recordVersion', 0) > 0
        && data.get('createdAt', null) is timestamp
        && data.get('createdBy', '') is string
        && data.get('updatedAt', null) is timestamp
        && data.get('updatedBy', '') is string
        && (
          data.get('lastViewedAt', null) == null
          || data.get('lastViewedAt', null) is timestamp
        );
    }

    function canCreateCareerRelationship(districtID, studentID, careerID) {
      return (
          canCollaborateOnStudent(districtID, studentID)
          || respondentMayWriteCareerRelationship(
            districtID,
            studentID,
            request.resource.data
          )
        )
        && isValidCareerRelationship(
          districtID,
          studentID,
          careerID,
          request.resource.data
        )
        && request.resource.data.get('recordVersion', 0) == 1
        && request.resource.data.get('createdAt', null) == request.time
        && request.resource.data.get('updatedAt', null) == request.time
        && request.resource.data.get('createdBy', '') == request.auth.uid
        && request.resource.data.get('updatedBy', '') == request.auth.uid;
    }

    function canUpdateCareerRelationship(districtID, studentID, careerID) {
      return (
          canCollaborateOnStudent(districtID, studentID)
          || respondentMayWriteCareerRelationship(
            districtID,
            studentID,
            request.resource.data
          )
        )
        && isValidCareerRelationship(
          districtID,
          studentID,
          careerID,
          request.resource.data
        )
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'districtID',
          'studentID',
          'careerID',
          'linkedPlanIDs',
          'schemaVersion',
          'createdAt',
          'createdBy'
        ])
        && request.resource.data.get('recordVersion', 0)
          == resource.data.get('recordVersion', 0) + 1
        && request.resource.data.get('updatedAt', null) == request.time
        && request.resource.data.get('updatedBy', '') == request.auth.uid;
    }

    // Career choices are shared state: an educator may seed a relationship
    // and the student may later change it in a different supervised session.
    // The active respondent claim scopes every write; an optional session ID
    // records provenance but never becomes permanent ownership of the edge.
    function respondentMayWriteCareerRelationship(
      districtID,
      studentID,
      data
    ) {
      return respondentMay(
          districtID,
          studentID,
          'updateCareerState'
        )
        && data.get('districtID', '') == districtID
        && data.get('studentID', '') == studentID
        && data.get(
          'respondentSessionID',
          request.auth.token.get('tmiSessionID', '')
        ) == request.auth.token.get('tmiSessionID', '');
    }

    function canReadPlan(districtID, planID, planData) {
      let schoolIDs = planData.get('schoolIDs', []);
      return hasActiveMembership(districtID)
        && (
          role(districtID) == 'districtAdministrator'
          || (
            schoolIDs.size() == 1
            && schoolIDs.hasOnly(membership(districtID).get('schoolIDs', []))
            && (
              role(districtID) == 'teacher'
              || role(districtID) == 'schoolAdministrator'
              || (
                role(districtID) in ['counselor', 'socialWorker']
                && request.auth.uid in planData.get('assignedMemberIDs', [])
              )
            )
          )
        );
    }

    function canWritePlan(districtID, planID, planData) {
      let studentIDs = planData.get('studentIDs', []);
      let schoolIDs = planData.get('schoolIDs', []);
      return hasActiveMembership(districtID)
        && planData.get('districtId', districtID) == districtID
        && studentIDs.size() > 0
        && (
          (
            role(districtID) in ['teacher', 'counselor', 'socialWorker']
            && request.auth.uid in planData.get('assignedMemberIDs', [])
            && schoolIDs.size() > 0
            && schoolIDs.hasOnly(membership(districtID).get('schoolIDs', []))
          )
          || (
            role(districtID) == 'schoolAdministrator'
            && hasCapability(districtID, 'student.write.detail')
            && schoolIDs.size() > 0
            && schoolIDs.hasOnly(membership(districtID).get('schoolIDs', []))
          )
          || (
            role(districtID) == 'districtAdministrator'
            && hasCapability(districtID, 'student.write.detail')
          )
        );
    }

    function planData(districtID, planID) {
      return get(
        /databases/$(database)/documents/districts/$(districtID)/plans/$(planID)
      ).data;
    }

    function canReadAggregate(districtID, snapshotData) {
      return hasActiveMembership(districtID)
        && (
          role(districtID) == 'districtAdministrator'
          || (
            role(districtID) == 'schoolAdministrator'
            && snapshotData.get('schoolId', '') in membership(districtID).get('schoolIDs', [])
          )
        );
    }

    function profileCreateKeysAreAllowed(data) {
      return data.keys().hasOnly([
        'userID',
        'uid',
        'displayName',
        'email',
        'isEmailVerified',
        'requestedRole',
        'dateOfBirth',
        'institutionCode',
        'institutionName',
        'photoURL',
        'organization',
        'verificationStatus',
        'consentRecords',
        'parentalConsentStatus',
        'ageVerificationStatus',
        'privacySettings',
        'createdAt',
        'lastLoginAt',
        'lastActivityAt',
        'emergencyContacts',
        'formTemplates'
      ]);
    }

    function profileUpdateKeysAreAllowed() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'displayName',
        'requestedRole',
        'dateOfBirth',
        'institutionCode',
        'institutionName',
        'photoURL',
        'organization',
        'privacySettings',
        'lastLoginAt',
        'lastActivityAt',
        'emergencyContacts',
        'formTemplates'
      ]);
    }

    // Everything under users/{userID} is personal data owned by that account.
    // The owner may erase it, which is what account deletion means and what the
    // App Store requires. Institution-owned educational records live under
    // districts/ and are unreachable from here, so this cannot destroy them.
    match /users/{userID} {
      allow read: if isAuthenticatedNonRespondent()
        && request.auth.uid == userID;
      allow create: if isAuthenticatedNonRespondent()
        && request.auth.uid == userID
        && profileCreateKeysAreAllowed(request.resource.data);
      allow update: if isAuthenticatedNonRespondent()
        && request.auth.uid == userID
        && profileUpdateKeysAreAllowed();
      allow delete: if isAuthenticatedNonRespondent()
        && request.auth.uid == userID;

      match /private/profile {
        allow read: if isAuthenticatedNonRespondent()
          && request.auth.uid == userID;
        allow create: if isAuthenticatedNonRespondent()
          && request.auth.uid == userID
          && profileCreateKeysAreAllowed(request.resource.data);
        allow update: if isAuthenticatedNonRespondent()
          && request.auth.uid == userID
          && profileUpdateKeysAreAllowed();
        allow delete: if isAuthenticatedNonRespondent()
          && request.auth.uid == userID;
      }

      match /preferences/settings {
        allow read, create, update: if isAuthenticatedNonRespondent()
          && request.auth.uid == userID;
        allow delete: if isAuthenticatedNonRespondent()
          && request.auth.uid == userID;
      }

      match /{legacyPath=**} {
        allow read, write: if false;
      }
    }

    match /districts/{districtID} {
      allow read: if hasActiveMembership(districtID);
      allow write: if false;

      match /schools/{schoolID} {
        allow read: if hasActiveMembership(districtID)
          && (
            role(districtID) == 'districtAdministrator'
            || belongsToSchool(districtID, schoolID)
          );
        allow write: if false;
      }

      match /members/{userID} {
        allow read: if hasActiveMembership(districtID)
          && (
            request.auth.uid == userID
            || hasCapability(districtID, 'staff.manage')
          );
        allow write: if false;

        match /acknowledgements/{acknowledgementID} {
          allow read: if hasActiveMembership(districtID)
            && request.auth.uid == userID;
          allow create: if hasActiveMembership(districtID)
            && request.auth.uid == userID
            && request.resource.data.keys().hasOnly([
              'documentID',
              'version',
              'acceptedAt',
              'operationID'
            ]);
          allow update, delete: if false;
        }
      }

      match /students/{studentID} {
        allow get: if canReadStudent(districtID, studentID, resource.data);
        allow list: if canListStudent(districtID, resource.data);
        allow create: if canClientWriteStudent(districtID, request.resource.data)
          && request.resource.data.get('isArchived', true) == false
          && request.resource.data.get('recordVersion', 0) == 1;
        // Both sides are checked so a member cannot attach themselves to a
        // student they could not already write, nor move one out of reach.
        allow update: if canClientWriteStudent(districtID, resource.data)
          && canClientWriteStudent(districtID, request.resource.data)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'districtId',
            'schemaVersion',
            'createdAt',
            'createdBy'
          ])
          && request.resource.data.get('recordVersion', 0)
            == resource.data.get('recordVersion', 0) + 1;
        allow delete: if false;

        match /studentSafe/profile {
          allow get: if respondentMay(
            districtID,
            studentID,
            'readStudentSafeProfile'
          );
          allow list, write: if false;
        }

        match /restrictedRecords/{recordID} {
          allow read: if canReadRestrictedStudentRecord(districtID, studentID);
          allow create, update: if canWriteRestrictedStudentRecord(districtID, studentID);
          allow delete: if false;
        }

        match /consents/{consentID} {
          allow read: if canReadRestrictedStudentRecord(districtID, studentID);
          allow create: if canWriteRestrictedStudentRecord(districtID, studentID);
          allow update, delete: if false;
        }

        match /responses/{responseID} {
          allow read: if canReadStudent(
              districtID,
              studentID,
              studentData(districtID, studentID)
            )
            || (
              respondentMay(districtID, studentID, 'readAssignment')
              && resource.data.get('districtID', '') == districtID
              && resource.data.get('studentID', '') == studentID
              && resource.data.get('assignmentID', '')
                == respondentAssignmentID(districtID)
              && resource.data.get('attemptID', '') == responseID
            );
          // Draft synchronization and submission run client-side while Cloud
          // Functions are undeployed. These rules restate the invariants the
          // callable enforced: identity fields match the path, the attempt
          // starts as a draft at version 1, versions advance by exactly one,
          // and canonical history is append-forward only. Review and any
          // mutation of a submitted attempt remain server-only.
          allow create: if canWriteSurveyResponse(districtID, studentID)
            && request.resource.data.get('districtID', '') == districtID
            && request.resource.data.get('studentID', '') == studentID
            && request.resource.data.get('attemptID', '') == responseID
            && request.resource.data.get('responseID', '') == responseID
            && request.resource.data.get('state', '') == 'draft'
            && request.resource.data.get('recordVersion', 0) == 1
            && request.resource.data.get('respondentUserID', '') == request.auth.uid;
          allow update: if canWriteSurveyResponse(districtID, studentID)
            && resource.data.get('state', '') == 'draft'
            && request.resource.data.get('state', '') in ['draft', 'submitted']
            && request.resource.data.get('recordVersion', 0)
              == resource.data.get('recordVersion', 0) + 1
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'districtID',
              'studentID',
              'assignmentID',
              'attemptID',
              'responseID',
              'definitionID',
              'definitionVersion',
              'respondentUserID',
              'createdAt'
            ]);
          allow delete: if false;
        }

        match /progress/{entryID} {
          allow read: if canReadStudent(
            districtID,
            studentID,
            studentData(districtID, studentID)
          );
          allow create: if canCollaborateOnStudent(districtID, studentID);
          allow update, delete: if false;
        }

        match /interests/{interestID} {
          allow read: if canReadStudent(
              districtID,
              studentID,
              studentData(districtID, studentID)
            );
          // A canonical interest edge is derived from an immutable submission by
          // the approval callable. No client authors one directly — a staff
          // client that could would be authoring district data by hand.
          allow create, update, delete: if false;
        }

        match /careers/{careerID} {
          allow read: if canReadStudent(
              districtID,
              studentID,
              studentData(districtID, studentID)
            );
          allow create: if canCreateCareerRelationship(
            districtID,
            studentID,
            careerID
          );
          allow update: if canUpdateCareerRelationship(
            districtID,
            studentID,
            careerID
          );
          allow delete: if false;
        }

        match /resources/{resourceID} {
          allow read: if (
              canReadStudent(
                districtID,
                studentID,
                studentData(districtID, studentID)
              )
              || respondentMay(
                districtID,
                studentID,
                'readStudentVisiblePlan'
              )
            )
            && (
              hasActiveMembership(districtID)
              || resource.data.get('studentVisible', false) == true
            );
          allow create, update: if canCollaborateOnStudent(
            districtID,
            studentID
          );
          allow delete: if false;
        }

        match /reflections/{reflectionID} {
          allow read: if canReadStudent(
            districtID,
            studentID,
            studentData(districtID, studentID)
          );
          allow create: if respondentMayWriteRecord(
            districtID,
            studentID,
            'writeReflection'
          );
          allow update: if respondentMayUpdateRecord(
            districtID,
            studentID,
            'writeReflection'
          );
          allow delete: if false;
        }

        match /checkIns/{checkInID} {
          allow read: if canReadStudent(
            districtID,
            studentID,
            studentData(districtID, studentID)
          );
          allow create: if respondentMayWriteRecord(
            districtID,
            studentID,
            'writeCheckIn'
          );
          allow update: if respondentMayUpdateRecord(
            districtID,
            studentID,
            'writeCheckIn'
          );
          allow delete: if false;
        }

        match /helpRequests/{requestID} {
          allow read: if canReadStudent(
            districtID,
            studentID,
            studentData(districtID, studentID)
          );
          allow create: if respondentMayWriteRecord(
            districtID,
            studentID,
            'requestHelp'
          );
          allow update, delete: if false;
        }

        match /{collectionName}/{recordID} {
          allow read: if collectionName in [
              'surveys',
              'notes'
            ]
            && canReadStudent(
              districtID,
              studentID,
              studentData(districtID, studentID)
            );
          allow create, update: if collectionName in [
              'surveys',
              'notes'
            ]
            && canCollaborateOnStudent(districtID, studentID);
          allow delete: if false;
        }
      }

      match /plans/{planID} {
        allow read: if canReadPlan(districtID, planID, resource.data);
        allow create: if canWritePlan(districtID, planID, request.resource.data)
          && request.resource.data.get('status', 'draft') == 'draft'
          && request.resource.data.get('approvalStatus', 'notRequested') == 'notRequested'
          && !request.resource.data.keys().hasAny(['approvedAt', 'approvedBy', 'approvalHistory', 'revisionSequence'])
          && request.auth.uid in request.resource.data.get('assignedMemberIDs', []);
        // Lifecycle, approvals and history belong to the trusted callable.
        allow update: if canWritePlan(districtID, planID, resource.data)
          && canWritePlan(districtID, planID, request.resource.data)
          && resource.data.get('status', '') in ['draft', 'changesRequested']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'title', 'summary', 'modelID', 'startDate', 'targetDate',
            'recordVersion', 'updatedAt', 'updatedBy'
          ])
          && request.resource.data.recordVersion == resource.data.recordVersion + 1
          && request.resource.data.updatedBy == request.auth.uid;
        allow delete: if false;

        match /approvals/{approvalID} {
          allow read: if canReadPlan(
            districtID,
            planID,
            planData(districtID, planID)
          );
          allow write: if false;
        }

        match /revisions/{revisionID} {
          allow read: if canReadPlan(
            districtID,
            planID,
            planData(districtID, planID)
          );
          allow create: if false;
          allow update, delete: if false;
        }

        match /progress/{entryID} {
          allow read: if canReadPlan(
            districtID,
            planID,
            planData(districtID, planID)
          );
          allow create: if canWritePlan(
            districtID,
            planID,
            planData(districtID, planID)
          )
            && planData(districtID, planID).get('status', '') in ['active', 'paused']
            && request.resource.data.get('planID', '') == planID
            && request.resource.data.get('studentID', '') in planData(districtID, planID).studentIDs
            && request.resource.data.get('authorID', '') == request.auth.uid;
          allow update, delete: if false;
        }

        match /{collectionName}/{recordID} {
          allow read: if (
              collectionName in ['goals', 'actions', 'resources', 'forms']
              && canReadPlan(
                districtID,
                planID,
                planData(districtID, planID)
              )
            )
            || (
              collectionName in ['goals', 'actions', 'resources']
              && respondentMayReadPlanRecord(
                districtID,
                planID,
                resource.data
              )
            );
          allow create: if collectionName in ['goals', 'actions', 'resources', 'forms']
            && canWritePlan(districtID, planID, planData(districtID, planID))
            && planData(districtID, planID).get('status', '') in ['draft', 'changesRequested']
            && request.resource.data.get('planID', '') == planID;
          allow update: if collectionName in ['goals', 'actions', 'resources', 'forms']
            && canWritePlan(districtID, planID, planData(districtID, planID))
            && request.resource.data.get('planID', '') == planID
            && (planData(districtID, planID).get('status', '') in ['draft', 'changesRequested']
              || (collectionName in ['goals', 'actions']
                && planData(districtID, planID).get('status', '') in ['active', 'paused']
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
                && ((collectionName == 'goals' && request.resource.data.status in ['notStarted', 'inProgress', 'met', 'discontinued'])
                  || (collectionName == 'actions' && request.resource.data.status in ['open', 'done', 'skipped']))));
          allow delete: if false;
        }
      }

      match /meetings/{meetingID} {
        allow read: if hasActiveMembership(districtID)
          && request.auth.uid in resource.data.get('participantUserIDs', []);
        allow create: if hasActiveMembership(districtID)
          && request.auth.uid in request.resource.data.get('participantUserIDs', []);
        allow update: if hasActiveMembership(districtID)
          && request.auth.uid in resource.data.get('participantUserIDs', [])
          && request.auth.uid in request.resource.data.get('participantUserIDs', []);
        allow delete: if false;
      }

      match /tasks/{taskID} {
        allow read: if hasActiveMembership(districtID)
          && (
            resource.data.get('assigneeUserID', '') == request.auth.uid
            || resource.data.get('createdBy', '') == request.auth.uid
          );
        allow create: if hasActiveMembership(districtID)
          && request.resource.data.get('createdBy', '') == request.auth.uid;
        allow update: if hasActiveMembership(districtID)
          && (
            resource.data.get('assigneeUserID', '') == request.auth.uid
            || resource.data.get('createdBy', '') == request.auth.uid
          )
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'districtId',
            'createdAt',
            'createdBy'
          ]);
        allow delete: if false;
      }

      match /formTemplates/{templateID} {
        allow read: if (
            hasActiveMembership(districtID)
            && (
              resource.data.get('schoolId', null) == null
              || role(districtID) == 'districtAdministrator'
              || belongsToSchool(districtID, resource.data.get('schoolId', ''))
            )
          )
          || (
            respondentMay(
              districtID,
              request.auth.token.get('tmiStudentID', ''),
              'readAssignment'
            )
            && hasActiveRespondentAssignment(districtID)
            && respondentAssignment(districtID).get('templateId', '')
              == templateID
          );
        allow create: if hasActiveMembership(districtID)
          && request.resource.data.get('districtId', districtID) == districtID
          && (
            role(districtID) == 'districtAdministrator'
            || belongsToSchool(
              districtID,
              request.resource.data.get('schoolId', '')
            )
          );
        allow update: if hasActiveMembership(districtID)
          && resource.data.get('districtId', districtID) == districtID
          && request.resource.data.get('districtId', districtID) == districtID
          && resource.data.get('schoolId', null) == request.resource.data.get('schoolId', null)
          && (
            role(districtID) == 'districtAdministrator'
            || belongsToSchool(districtID, resource.data.get('schoolId', ''))
          );
        allow delete: if false;
      }

      match /formAssignments/{assignmentID} {
        allow read: if (
            hasActiveMembership(districtID)
            && (
              resource.data.get('assignedBy', '') == request.auth.uid
              || resource.data.get('studentIDs', []).hasOnly(
                membership(districtID).get('assignedStudentIDs', [])
              )
              || role(districtID) in ['schoolAdministrator', 'districtAdministrator']
            )
          )
          || (
            respondentMay(
              districtID,
              request.auth.token.get('tmiStudentID', ''),
              'readAssignment'
            )
            && assignmentID == respondentAssignmentID(districtID)
            && resource.data.get('isActive', false) == true
            && resource.data.get('districtId', '') == districtID
            && request.auth.token.get('tmiStudentID', '')
              in resource.data.get('studentIDs', [])
          );
        allow create: if hasActiveMembership(districtID)
          && request.resource.data.get('assignedBy', '') == request.auth.uid
          && request.resource.data.get('districtId', districtID) == districtID
          && request.resource.data.get('assignmentType', '') != 'survey'
          && !request.resource.data.keys().hasAny([
            'definitionID',
            'definitionVersion',
            'attemptID'
          ])
          && request.resource.data.get('studentIDs', []).hasOnly(
            membership(districtID).get('assignedStudentIDs', [])
          );
        allow update: if hasActiveMembership(districtID)
          && resource.data.get('assignedBy', '') == request.auth.uid
          && request.resource.data.get('assignedBy', '') == request.auth.uid
          && request.resource.data.get('districtId', districtID) == districtID
          && resource.data.get('assignmentType', '') != 'survey'
          && request.resource.data.get('assignmentType', '') != 'survey'
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'assignmentType',
            'definitionID',
            'definitionVersion',
            'attemptID',
            'studentIDs',
            'isActive',
            'districtId'
          ])
          && request.resource.data.get('studentIDs', []).hasOnly(
            membership(districtID).get('assignedStudentIDs', [])
          );
        allow delete: if false;

        match /respondents/{respondentID} {
          allow read: if hasActiveMembership(districtID);
          allow write: if false;
        }
      }

      match /resources/{resourceID} {
        allow read: if hasActiveMembership(districtID)
          && (
            resource.data.get('schoolId', null) == null
            || role(districtID) == 'districtAdministrator'
            || belongsToSchool(districtID, resource.data.get('schoolId', ''))
          );
        allow create: if hasActiveMembership(districtID)
          && (
            role(districtID) == 'districtAdministrator'
            || belongsToSchool(
              districtID,
              request.resource.data.get('schoolId', '')
            )
          );
        allow update: if hasActiveMembership(districtID)
          && request.resource.data.get('schoolId', null) == resource.data.get('schoolId', null)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['createdBy', 'createdAt', 'districtId'])
          && (role(districtID) == 'districtAdministrator'
            || belongsToSchool(districtID, resource.data.get('schoolId', '')));
        allow delete: if false;
      }

      match /notifications/{notificationID} {
        allow read: if hasActiveMembership(districtID)
          && resource.data.get('recipientUserID', '') == request.auth.uid;
        allow update: if hasActiveMembership(districtID)
          && resource.data.get('recipientUserID', '') == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'isRead',
            'readAt'
          ]);
        allow create, delete: if false;
      }

      match /studentModeSessions/{sessionID} {
        allow read, write: if false;
      }

      match /auditEvents/{eventID} {
        allow read: if hasActiveMembership(districtID)
          && (
            resource.data.get(
              'actorUserID',
              resource.data.get('userID', '')
            ) == request.auth.uid
            || hasCapability(districtID, 'audit.read')
          );
        allow write: if false;
      }

      match /metricSnapshots/{snapshotID} {
        allow read: if canReadAggregate(districtID, resource.data);
        allow write: if false;
      }

      match /settings/{settingID} {
        allow read: if hasActiveMembership(districtID);
        allow write: if hasActiveMembership(districtID)
          && role(districtID) == 'districtAdministrator';
      }

      match /complianceAudits/{auditID} {
        allow read: if hasActiveMembership(districtID);
        allow create, update: if hasActiveMembership(districtID)
          && role(districtID) == 'districtAdministrator';
        allow delete: if false;
      }

      match /{unmatched=**} {
        allow read, write: if false;
      }
    }

    match /catalogs/{catalogName}/items/{itemID} {
      allow read: if (
          isAuthenticated()
          && request.auth.token.get('tmiAccessClass', '') != 'respondent'
          && catalogName in [
            'careers',
            'interests',
            'globalResources',
            'tmiModels',
            'surveyDefinitions'
          ]
        )
        || (
          (
            catalogName == 'careers'
            && resource.data.get('isApproved', false) == true
            && respondentMay(
              trustedDistrictID(),
              request.auth.token.get('tmiStudentID', ''),
              'readCareerCatalog'
            )
          )
          || (
            catalogName == 'surveyDefinitions'
            && resource.data.get('state', '') == 'published'
            && respondentMay(
              trustedDistrictID(),
              request.auth.token.get('tmiStudentID', ''),
              'readAssignment'
            )
            && respondentAssignment(trustedDistrictID()).get(
              'definitionID',
              ''
            ) == resource.data.get('definitionID', '')
            && respondentAssignment(trustedDistrictID()).get(
              'definitionVersion',
              0
            ) == resource.data.get('version', -1)
          )
        );
      allow write: if false;
    }

    match /{unmatched=**} {
      allow read, write: if false;
    }
  }
}
