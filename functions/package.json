{
  "name": "tmi-firebase",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "lib/src/index.js",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "node scripts/run-tests.mjs",
    "test:unit": "vitest run --dir test --maxWorkers=1 --fileParallelism=false",
    "emulators": "firebase emulators:start --config ../firebase.json --project demo-tmi",
    "debug-invitation:seed": "npm run build --silent && node scripts/manage-debug-invitation.mjs seed",
    "debug-invitation:revoke": "npm run build --silent && node scripts/manage-debug-invitation.mjs revoke",
    "migrate:dry-run": "npm run build && node lib/src/migrate.js --dry-run",
    "reconcile": "npm run build && node lib/src/reconcile.js",
    "fixture:release2": "node scripts/generate-release2-fixture.mjs"
  },
  "dependencies": {
    "firebase-admin": "14.2.0",
    "firebase-functions": "7.3.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.1",
    "firebase": "12.16.0",
    "firebase-tools": "15.24.0",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
